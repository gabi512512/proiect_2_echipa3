<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ro.tuiasi.ac</groupId>
  <artifactId>Proiect_PIP</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Proiect_PIP</name>
  <url>http://maven.apache.org</url>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Set your Java version here. Update if you use a different JDK. -->
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <!-- JavaFX version and platform classifier (win, linux, mac) -->
    <javafx.version>20</javafx.version>
    <javafx.platform>win</javafx.platform>
  </properties>

  <dependencies>
    <!-- JUnit (existing test dependency) -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>3.8.1</version>
      <scope>test</scope>
    </dependency>

    <!-- JavaFX modules -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <!-- Source: https://mvnrepository.com/artifact/io.gravitee.maven.plugins/json-schema-generator-maven-plugin -->
<dependency>
    <groupId>io.gravitee.maven.plugins</groupId>
    <artifactId>json-schema-generator-maven-plugin</artifactId>
    <version>1.3.0</version>
    <scope>compile</scope>
</dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Ensure correct Java version for compilation -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.8.1</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>

      <!-- JavaFX Maven plugin to run JavaFX apps: mvn javafx:run -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <!-- Update mainClass to the JavaFX Application class when you create one -->
          <mainClass>ro.tuiasi.ac.Proiect_PIP.App</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
